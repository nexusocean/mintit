# =============================================================================
# Test Environment (example)
# Copy to .env.test at repo root. Read by `pnpm test:e2e`.
#
# Unit tests (`pnpm test`) need nothing from this file: they never touch the
# network, a database or a wallet.
#
# Live tests run against an already-running instance. Point them at a dev or
# demo instance, never production: each run creates a few small invoices
# (they expire after 10 minutes) and logs in as the admin.
# =============================================================================

# Instance under test (no trailing slash, no /v1)
E2E_BASE_URL=http://localhost:3000

# Must match API_KEY on that instance
E2E_API_KEY=

# The instance's existing admin account
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# DEMO_ADMIN_TOTP on the instance, a backup code, or blank when the instance
# runs with AUTH_DISABLE_TOTP=true. A real authenticator code can't be
# replayed, so it only works for one run (and backup codes burn one per run).
E2E_ADMIN_TOTP=

# Optional: tests the CoinMarketCap provider directly. Skipped when blank.
# Kraken and CoinGecko are always tested (no key needed).
CMC_API_KEY=
